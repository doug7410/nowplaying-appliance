# Copy to pi/np.env (gitignored) and fill in. Injected into the systemd unit via
# EnvironmentFile, so the SHARED appliance token stays out of git AND out of the binary.
#   cp pi/np.env.example pi/np.env   # then edit
#
# TENANCY TRAP: NP_TOKEN MUST be the SAME shared appliance token Board 1 ingests under
# (reuse the one in ../nowplaying/firmware/board1-smoketest/src/secrets.h). A fresh token
# reads an empty tenant -> the screen shows state:"idle" forever. Never commit pi/np.env.
#
# Re-check the cloud host IP on the cloud box with: ip route get 1.1.1.1
NP_BASE_URL=http://<cloud-host>:8000/api
NP_TOKEN=paste-the-SHARED-appliance-token-here
