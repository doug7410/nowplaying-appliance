// Copy to src/secrets.h (gitignored) and fill in:
//
//   cp src/secrets.h.example src/secrets.h   # then edit
//
// ⚠️ TENANCY — the #1 trap: Board 2 MUST authenticate with the SAME shared
// appliance bearer token Board 1 ingests under. `/nowplaying` and `recent[]` are
// scoped per-Device, so a *fresh* `php artisan device:create` token reads an empty
// tenant and shows state:"idle" forever. Reuse the token already on disk in
// firmware/board1-smoketest/src/secrets.h — do NOT mint a new one. Never commit it.
//
// Re-check the cloud host IP on the cloud box with: ip route get 1.1.1.1

#pragma once

#define WIFI_SSID      "your-ssid"
#define WIFI_PASSWORD  "your-password"

// Cloud gate (no trailing slash). The live LAN dev gate:
#define BASE_URL       "http://192.168.1.163:8000/api"
#define DEVICE_TOKEN   "paste-the-SHARED-appliance-token-here"  // SAME token as board1
